# Copy this file to .env and adjust.

# Public domain — used in the UI and embedded in QR codes.
BASE_URL=https://s.pfadis.ch

# Optional: set a key to allow script/automation access (sent as
# "Authorization: Bearer <key>"). Not needed if you're using Google sign-in.
API_KEY=

# Google sign-in — see README "Setting up Google sign-in" for how to get
# these from Google Cloud Console. Leave both blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only accounts on this domain (Google Workspace) can sign in.
GOOGLE_ALLOWED_DOMAIN=pfadis.ch

# Signs the session cookie. Generate one with: openssl rand -hex 32
# If left blank, a random one is generated on each restart, which signs
# everyone out whenever the container restarts.
SESSION_SECRET=

# If GOOGLE_CLIENT_ID/SECRET and API_KEY are all left blank, the app runs
# with no login at all — anyone who can reach it can create/delete links.
